{
  "name": "equilibrium-finance",
  "version": "0.1.0",
  "description": "Equilibrium Finance — a premium personal finance tracker. Architectural Vault design system.",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "ios": "expo run:ios",
    "ios:go": "expo start --ios --go",
    "android": "expo run:android",
    "android:go": "expo start --android --go",
    "web": "expo start --web",
    "prebuild": "expo prebuild && node scripts/patch-gradle.mjs",
    "patch:gradle": "node scripts/patch-gradle.mjs",
    "icons": "node scripts/build-icons.mjs",
    "preflight": "node scripts/preflight.mjs",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:production": "eas build --platform ios --profile production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.2.3",
    "@expo/vector-icons": "~14.0.4",
    "@hookform/resolvers": "^3.9.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.4.1",
    "@shopify/flash-list": "1.7.3",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/query-async-storage-persister": "^5.59.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-query-persist-client": "^5.59.0",
    "date-fns": "^3.6.0",
    "expo": "~52.0.0",
    "expo-blur": "~14.0.1",
    "expo-constants": "~17.0.3",
    "expo-font": "~13.0.1",
    "expo-haptics": "~14.0.0",
    "expo-linear-gradient": "~14.0.1",
    "expo-linking": "~7.0.3",
    "expo-local-authentication": "~15.0.1",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-splash-screen": "~0.29.13",
    "expo-status-bar": "~2.0.0",
    "expo-symbols": "~0.2.0",
    "expo-system-ui": "~4.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.53.0",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.13",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.12",
    "sharp": "^0.33.5",
    "typescript": "~5.3.3"
  }
}
