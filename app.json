{
  "expo": {
    "name": "Equilibrium",
    "slug": "equilibrium-finance",
    "scheme": "equilibrium",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#080e1a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.equilibrium.finance",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Equilibrium uses Face ID to unlock your Vault."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080e1a"
      },
      "package": "com.equilibrium.finance",
      "permissions": ["android.permission.USE_BIOMETRIC", "android.permission.USE_FINGERPRINT"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Equilibrium uses Face ID to unlock your Vault."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080e1a",
          "image": "./assets/splash.png",
          "resizeMode": "contain"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "replace-with-your-eas-project-id"
      }
    }
  }
}
