# Equilibrium Finance — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
#
# Expo exposes any variable prefixed with EXPO_PUBLIC_ to client code at build time.
# The Supabase anon key is safe to ship client-side *only* when Row Level Security is
# enabled on every table (see supabase/migrations). Service-role keys must NEVER be
# placed here — they bypass RLS and belong only on a trusted server.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: default currency for new users (ISO 4217). Users can override in Settings.
EXPO_PUBLIC_DEFAULT_CURRENCY=USD
